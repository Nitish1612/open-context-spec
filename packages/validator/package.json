{
  "name": "@ulcs/validator",
  "version": "0.1.0",
  "description": "Open Context Specification (OCS) — JSON Schema 2020-12 validation for ContextEnvelope, ContextItem, and ContextPatch documents, with schemas bundled for standalone use. Provisional package name; drafted under the working name Universal LLM Context Schema (ULCS), see ADR-0004.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/Nitish1612/open-context-spec.git",
    "directory": "packages/validator"
  },
  "bugs": {
    "url": "https://github.com/Nitish1612/open-context-spec/issues"
  },
  "homepage": "https://github.com/Nitish1612/open-context-spec/tree/main/packages/validator#readme",
  "keywords": [
    "llm",
    "context-engineering",
    "json-schema",
    "ajv",
    "validation",
    "json-ld",
    "typescript",
    "open-context-specification"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "schemas",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18.18.0"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean --target node18",
    "dev": "tsup src/index.ts --format esm --dts --watch --target node18",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@ulcs/core": "workspace:*",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1"
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "tsup": "^8.3.5"
  }
}
