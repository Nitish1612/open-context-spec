{
  "@context": {
    "@version": 1.1,
    "ulcs": "https://ulcs.dev/vocab#",
    "xsd": "http://www.w3.org/2001/XMLSchema#",

    "id": "@id",
    "type": "@type",

    "schemaVersion": "ulcs:schemaVersion",
    "createdAt": { "@id": "ulcs:createdAt", "@type": "xsd:dateTime" },
    "updatedAt": { "@id": "ulcs:updatedAt", "@type": "xsd:dateTime" },
    "validFrom": { "@id": "ulcs:validFrom", "@type": "xsd:dateTime" },
    "validUntil": { "@id": "ulcs:validUntil", "@type": "xsd:dateTime" },
    "retrievedAt": { "@id": "ulcs:retrievedAt", "@type": "xsd:dateTime" },
    "contentTimestamp": { "@id": "ulcs:contentTimestamp", "@type": "xsd:dateTime" },
    "timestamp": { "@id": "ulcs:timestamp", "@type": "xsd:dateTime" },

    "content": "ulcs:content",
    "status": "ulcs:status",
    "priority": "ulcs:priority",
    "relevance": "ulcs:relevance",
    "scope": "ulcs:scope",
    "tags": "ulcs:tags",
    "source": "ulcs:source",
    "trust": "ulcs:trust",
    "sensitivity": "ulcs:sensitivity",
    "relationships": "ulcs:relationships",
    "extensions": "ulcs:extensions",

    "ContextEnvelope": "ulcs:ContextEnvelope",
    "Objective": "ulcs:Objective",
    "Task": "ulcs:Task",
    "Actor": "ulcs:Actor",
    "Entity": "ulcs:Entity",
    "Relationship": "ulcs:Relationship",
    "Instruction": "ulcs:Instruction",
    "Fact": "ulcs:Fact",
    "Assumption": "ulcs:Assumption",
    "Constraint": "ulcs:Constraint",
    "Preference": "ulcs:Preference",
    "Decision": "ulcs:Decision",
    "Question": "ulcs:Question",
    "ConversationMessage": "ulcs:ConversationMessage",
    "MemoryItem": "ulcs:MemoryItem",
    "Resource": "ulcs:Resource",
    "Citation": "ulcs:Citation",
    "Provenance": "ulcs:Provenance",
    "ToolDefinition": "ulcs:ToolDefinition",
    "ToolResult": "ulcs:ToolResult",
    "OutputContract": "ulcs:OutputContract",
    "SecurityPolicy": "ulcs:SecurityPolicy",
    "TokenPolicy": "ulcs:TokenPolicy",
    "ContextPatch": "ulcs:ContextPatch",
    "ContextSummary": "ulcs:ContextSummary",
    "Error": "ulcs:Error",

    "objective": "ulcs:objective",
    "actors": "ulcs:actors",
    "instructions": "ulcs:instructions",
    "facts": "ulcs:facts",
    "assumptions": "ulcs:assumptions",
    "constraints": "ulcs:constraints",
    "preferences": "ulcs:preferences",
    "decisions": "ulcs:decisions",
    "questions": "ulcs:questions",
    "conversation": "ulcs:conversation",
    "resources": "ulcs:resources",
    "entities": "ulcs:entities",
    "relationships_": "ulcs:relationships",
    "memory": "ulcs:memory",
    "tools": "ulcs:tools",
    "toolResults": "ulcs:toolResults",
    "outputContract": "ulcs:outputContract",
    "security": "ulcs:security",
    "tokenPolicy": "ulcs:tokenPolicy",
    "summary": "ulcs:summary",
    "errors": "ulcs:errors",

    "authority": "ulcs:authority",
    "role": "ulcs:role",
    "level": "ulcs:level",
    "providesData": "ulcs:providesData",
    "providesInstructions": "ulcs:providesInstructions",
    "sourceUri": { "@id": "ulcs:sourceUri", "@type": "@id" },
    "sourceType": "ulcs:sourceType"
  }
}
